+  },
+  // ── Water ──
+  {
+    id: 'wa_bath', category: 'water', ask: () => 'How do you usually bathe?',
+    options: [{ id: 'bucket', label: 'Bucket bath' }, { id: 'short_shower', label: 'Short shower (5 min)' }, { id: 'long_shower', label: 'Long shower' }, { id: 'tub', label: 'Bathtub' }],
